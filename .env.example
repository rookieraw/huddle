# Docker Compose — host-side port overrides (only needed if a port conflicts locally)
POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379

# apps/api-gateway
# Note: not yet read via dotenv/@nestjs/config — that wiring starts Phase 1.
# Currently just a hardcoded fallback in src/main.ts.
PORT=4000

# libs/identity (and other contexts sharing the same Postgres instance, different schemas)
DATABASE_URL="postgresql://huddle:huddle_dev_password@localhost:5432/huddle"

JWT_SECRET="replace-with-a-long-random-string"

GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/oauth/google/callback"

GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"
GITHUB_CALLBACK_URL="http://localhost:4000/auth/oauth/github/callback"